# test-dns: Quick diagnostic DNS test tool for GNS3 netclient
set -e

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
RED="\033[31m"
YELLOW="\033[33m"
RESET="\033[0m"

TARGET="${1:-}"

if [ -z "$TARGET" ]; then
    # Auto-detect search domain from /etc/resolv.conf, default to www.lab.local
    SEARCH_DOM=$(grep -E '^search' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | head -n1)
    if [ -n "$SEARCH_DOM" ]; then
        TARGET="www.${SEARCH_DOM}"
    else
        TARGET="www.lab.local"
    fi
fi

echo -e "${BOLD}${CYAN}Testing DNS resolution for: ${YELLOW}${TARGET}${RESET}"

# Find configured nameservers
NAMESERVERS=$(grep -E '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}' || true)
if [ -z "$NAMESERVERS" ]; then
    echo -e "${RED}[!] No nameservers found in /etc/resolv.conf!${RESET}"
else
    echo -e "Using configured nameservers: ${GREEN}${NAMESERVERS}${RESET}"
fi

echo -e "\n${BOLD}[1/2] dig query:${RESET}"
if command -v dig >/dev/null 2>&1; then
    dig "$TARGET" +noall +answer +stats || echo -e "${RED}dig failed${RESET}"
else
    echo -e "${RED}dig command not installed${RESET}"
fi

echo -e "\n${BOLD}[2/2] host query:${RESET}"
if command -v host >/dev/null 2>&1; then
    host "$TARGET" || echo -e "${RED}host lookup failed${RESET}"
else
    echo -e "${RED}host command not installed${RESET}"
fi

echo ""
